@page "/home"
@using Autonomuse.Components.Tabs
@using Autonomuse.Shared.Contracts
@using Autonomuse.ViewModels
@inject IHomeUIService UIService
@inject ISettingsService SettingsService
@inject IJSRuntime JS

<style>
    :root {
        --left-blur: @(Settings.LeftBlur)px;
        --left-opacity: @(Settings.LeftOpacity);
        --right-blur: @(Settings.RightBlur)px;
        --right-opacity: @(Settings.RightOpacity);
        --card-blur: @(Settings.CardBlur)px;
        --card-opacity: @(Settings.CardOpacity);
        --card-color: @(Settings.CardColor);
        --card-bg-rgb: @(ColorThemeService.HexToRgb(Settings.CardColor));
        --card-bg: rgba(@(ColorThemeService.HexToRgb(Settings.CardColor)), @(Settings.CardOpacity));
        --menu-blur: @(Settings.MenuBlur)px;
        --menu-opacity: @(Settings.MenuOpacity);
        --general-text: @(Settings.GeneralTextColor);
        --text-shadow-val: @(Settings.EnableTextShadow ? $"0 2px 4px rgba(0,0,0,{Settings.TextShadowOpacity})" : "0 0 0 transparent");
        @{
            var outlineRgb = Settings.TextOutlineColor == "#ffffff" ? "255, 255, 255" : "0, 0, 0";
            var outlineColor = $"rgba({outlineRgb}, {Settings.TextOutlineOpacity})";
        }
        --text-outline-shadow: @(Settings.EnableTextOutline ? $"0.03em 0.03em 0 {outlineColor}, -0.03em -0.03em 0 {outlineColor}, 0.03em -0.03em 0 {outlineColor}, -0.03em 0.03em 0 {outlineColor}" : "0 0 0 transparent");
        --header-bg: @(Settings.EnableHeaderBackground ? $"rgba({ColorThemeService.HexToRgb(Settings.HeaderBackgroundColor)}, {Settings.HeaderBackgroundOpacity})" : "transparent");
        --header-padding: @(Settings.EnableHeaderBackground ? $"{Settings.HeaderPaddingTop}px {Settings.HeaderPaddingRight}px {Settings.HeaderPaddingBottom}px {Settings.HeaderPaddingLeft}px" : "0px");
        --header-radius: @(Settings.EnableHeaderBackground ? $"{Settings.HeaderBackgroundRadius}px" : "0px");
        --header-font-size: @(Settings.EnableHeaderBackground ? $"{Settings.HeaderFontSize}px" : "25px");
        --subheading-font-size: @(Settings.EnableHeaderBackground ? $"{Settings.SubheadingFontSize}px" : "1.1rem");
        --subheading-color: @(Settings.SubheadingTextColor);
        --header-box-decoration: @(Settings.EnableHeaderBackground ? "clone" : "unset");
        --bg-layer1: url('@Layer1Bg');
        --bg-layer2: url('@Layer2Bg');
    }

    .changelog-modal {
        width: 560px;
        max-height: 80vh;
        display: flex;
        flex-direction: column;
    }
    .changelog-body {
        overflow-y: auto;
        max-height: 60vh;
        padding: 1rem 0;
        line-height: 1.6;
        font-size: 0.9rem;
    }
    .changelog-body h1 { font-size: 1.2rem; color: var(--accent-base); margin: 0 0 0.5rem; }
    .changelog-body h2 { font-size: 1rem; color: var(--accent-base); margin: 1rem 0 0.25rem; }
    .changelog-body ul { margin: 0.25rem 0; padding-left: 1.2rem; }
    .changelog-body li { margin: 0.15rem 0; }
    .changelog-body hr { border: none; border-top: 1px solid rgba(255,255,255,0.1); margin: 0.75rem 0; }
    .modal-backdrop {
        position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
        background: rgba(0,0,0,0.7); backdrop-filter: blur(8px);
        display: flex; justify-content: center; align-items: center;
        z-index: 2000;
    }
    .modal-card {
        background: var(--card-bg, rgba(18,18,18,0.4));
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 16px; padding: 1.8rem;
    }
    .modal-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 0.75rem; }
    .modal-header h3 { margin: 0; color: var(--accent-base); font-size: 1.1rem; text-transform: uppercase; letter-spacing: 1px; }
    .close-btn { background: transparent; border: none; color: #888; font-size: 1.5rem; cursor: pointer; padding: 0; line-height: 1; }
    .close-btn:hover { color: #fff; }
    .modal-footer { display: flex; justify-content: flex-end; padding-top: 1rem; }
    .action-btn.gold {
        background: linear-gradient(135deg, var(--accent-bright) 0%, var(--accent-dark) 100%);
        color: var(--accent-text); border: none; padding: 10px 24px; border-radius: 50px;
        font-size: 0.85rem; font-weight: 700; cursor: pointer; transition: all 0.2s;
    }
    .action-btn.gold:hover { filter: brightness(1.2); transform: translateY(-2px); }
    .changelog-footer { padding-top: 1rem; }
    .changelog-got-it { width: 100%; text-align: center; justify-content: center; }
</style>

<div class="home-container">
    @* Background Layers for Cross-fade *@
    <div class="bg-layer layer1 @(IsLayer1Active ? "active" : "")"></div>
    <div class="bg-layer layer2 @(!IsLayer1Active ? "active" : "")"></div>

    <div class="left-container">
        <div class="left-bg-overlay"></div>
        <div class="menubutton-container">
            <button class="menubutton @(ActiveTab == TabType.Dashboard ? "active" : "")" 
                    @onclick="() => SetTab(TabType.Dashboard)">Dashboard</button>
            
            <div class="separator"></div>
            
            <button class="menubutton @(ActiveTab == TabType.Audio ? "active" : "")" 
                    @onclick="() => SetTab(TabType.Audio)">Audio</button>
            <button class="menubutton @(ActiveTab == TabType.Video ? "active" : "")" 
                    @onclick="() => SetTab(TabType.Video)">Video</button>
            <div class="separator"></div>
            
            <button class="menubutton @(ActiveTab == TabType.Settings ? "active" : "")" 
                    @onclick="() => SetTab(TabType.Settings)">Settings</button>
        </div>
        
        <div class="backstage-link-container">
            <button class="backstage-link @(ActiveTab == TabType.Backstage ? "active" : "")" 
                    @onclick="() => SetTab(TabType.Backstage)">backstage</button>
        </div>
    </div>
    
    <div class="right-container">
        @* Dedicated Background Overlay to prevent stacking filters on child elements *@
        <div class="right-bg-overlay"></div>
        
        <div class="right-content">
            @switch (ActiveTab)
            {
                case TabType.Dashboard:
                    <DashboardTab />
                    break;
                case TabType.Audio:
                    <AudioTab />
                    break;
                case TabType.Video:
                    <VideoTab />
                    break;
                case TabType.Settings:
                    <SettingTab OnSettingsChanged="OnSettingsChanged" />
                    break;
                case TabType.Backstage:
                    <BackstageTab />
                    break;
            }
        </div>
    </div>
</div>

@if (_showChangelog)
{
    <div class="modal-backdrop" @onclick="DismissChangelogAsync">
        <div class="modal-card changelog-modal" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>What's New</h3>
            </div>
            <div class="modal-body changelog-body">
                @((MarkupString)_changelogHtml)
            </div>
            <div class="modal-footer changelog-footer">
                <button class="action-btn gold changelog-got-it" @onclick="DismissChangelogAsync">Got it</button>
            </div>
        </div>
    </div>
}

@code {
    private enum TabType
    {
        Dashboard,
        Audio,
        Video,
        Settings,
        Backstage
    }

    private TabType ActiveTab { get; set; } = TabType.Dashboard;
    private HomeUISettings Settings { get; set; } = new();
    
    // Cross-fade state
    private string Layer1Bg { get; set; } = string.Empty;
    private string Layer2Bg { get; set; } = string.Empty;
    private bool IsLayer1Active { get; set; } = true;
    private bool _showChangelog;
    private string _changelogHtml = "";

    protected override async Task OnInitializedAsync()
    {
        Settings = await UIService.GetSettingsAsync();
        Layer1Bg = await UIService.GetBackgroundAsBase64Async(ActiveTab.ToString());
        await CheckChangelogAsync();
    }

    private async Task CheckChangelogAsync()
    {
        try
        {
        var currentVersion = DashboardViewModel.Version;
        var lastSeen = await SettingsService.GetSettingAsync("LastSeenVersion");
        if (lastSeen == currentVersion && lastSeen != null) return;

            string text;
            try
            {
                using var stream = await FileSystem.OpenAppPackageFileAsync("CHANGELOG.txt");
                using var reader = new System.IO.StreamReader(stream);
                text = await reader.ReadToEndAsync();
            }
            catch
            {
                var changelogPath = System.IO.Path.Combine(AppContext.BaseDirectory, "CHANGELOG.txt");
                var dir = AppContext.BaseDirectory;
                for (int i = 0; i < 6 && !System.IO.File.Exists(changelogPath); i++)
                {
                    dir = System.IO.Path.GetDirectoryName(dir);
                    if (dir == null) break;
                    changelogPath = System.IO.Path.Combine(dir, "CHANGELOG.txt");
                }
                if (!System.IO.File.Exists(changelogPath)) return;
                text = await System.IO.File.ReadAllTextAsync(changelogPath);
            }
            _changelogHtml = Markdig.Markdown.ToHtml(text);
            _showChangelog = true;
        }
        catch { }
    }

    private async Task DismissChangelogAsync()
    {
        _showChangelog = false;
        await SettingsService.SaveSettingAsync("LastSeenVersion", DashboardViewModel.Version);
        StateHasChanged();
    }

    private async Task SetTab(TabType tab)
    {
        if (ActiveTab == tab) return;
        
        ActiveTab = tab;
        await UpdateBackground();
        await JS.InvokeVoidAsync("window.scrollToTop");
    }

    private async Task OnSettingsChanged()
    {
        Settings = await UIService.GetSettingsAsync();
        // Force refresh the active layer
        var newBg = await UIService.GetBackgroundAsBase64Async(ActiveTab.ToString());
        if (IsLayer1Active) Layer1Bg = newBg; else Layer2Bg = newBg;
        
        StateHasChanged();
    }

    private async Task UpdateBackground()
    {
        var newBg = await UIService.GetBackgroundAsBase64Async(ActiveTab.ToString());
        
        // Swap layers
        if (IsLayer1Active)
        {
            Layer2Bg = newBg;
            IsLayer1Active = false;
        }
        else
        {
            Layer1Bg = newBg;
            IsLayer1Active = true;
        }
        
        StateHasChanged();
    }
}